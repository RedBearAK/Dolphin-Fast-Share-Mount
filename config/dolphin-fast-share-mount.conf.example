# Dolphin-Fast-Share-Mount settings
#
# One setting per line as key=value. Lines starting with # are ignored.
# Remove the # in front of a line to use it.

# User name for servers whose address does not name one.
# Default: your login name on this computer.
#user=

# Windows domain or workgroup to log in to, when the server needs one.
#domain=

# Pin the SMB version: 3.1.1, 3.0.2, 3.0, 3, 2.1, 2.0, default, or 1.0.
# Empty lets the kernel pick the newest version both sides speak (2.1 or
# later). 1.0 (SMB1) is insecure; set it only for an old server that needs it.
#smb_version=

# Where to open the mounted share: tab (Dolphin's own setting decides,
# usually a new tab in the open window), window, or none.
#open_mode=tab

# Save a password you typed: ask, always, or never.
#remember_password=ask

# Name of the mount folder: a pattern with {share} (required) and any of
#   {server_address}       the server as in the address (photos.local)
#   {server_display_name}  the name it announces, shown in Dolphin's
#                          network view (Photos), else the short name
#   {server_short_name}    the first part of the server's name (photos)
# Besides those, only letters, digits and . _ - + @ (nothing that needs
# quoting in a shell). Examples: {share}@{server_display_name}
# ("Backups@Photos"), {server_short_name}-{share}, {share}+{server_address},
# {share}.
#folder_name={share}@{server_display_name}

# Name in Dolphin's sidebar: folder_name (the same as the folder), or
# quoted text with the same placeholders, such as
# "{share} [{server_display_name}]" or "{share} on {server_address}".
# Over 40 characters, the middle becomes "…".
#sidebar_name=folder_name

# End of File #
