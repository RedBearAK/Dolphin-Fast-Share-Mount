[Desktop Entry]
Type=Service
MimeType=inode/directory;
X-KDE-Protocols=smb
X-KDE-Submenu=Fast Share Mount
X-KDE-Priority=TopLevel
Actions=mount;mountwindow;

[Desktop Action mount]
Name=Mount Here
Icon=folder-network
Exec="@BIN@" mount --gui %U

[Desktop Action mountwindow]
Name=Mount Here in New Window
Icon=window-new
Exec="@BIN@" mount --gui --window %U

# End of File #
